{
    "name": "twiggy-server",
    "version": "1.0.0",
    "description": "Twiggy platform server",
    "type": "module",
    "main": "src/server.ts",
    "prisma": {
        "seed": "tsx --tsconfig tsconfig.json -r tsconfig-paths/register prisma/seed.ts"
    },
    "scripts": {
        "dev": "tsx --tsconfig tsconfig.json -r tsconfig-paths/register src/server.ts",
        "dev:watch": "tsx watch --tsconfig tsconfig.json -r tsconfig-paths/register src/server.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "bcrypt": "^5.0.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.22.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.0",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.0.0",
        "prisma": "^5.22.0",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.0.0"
    }
}
